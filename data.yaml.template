# You normally don't need to hand-edit this — download_openimages_food.py
# generates dataset/data.yaml automatically with the right classes/paths.
# This template is here for reference or if you're adding your own
# locally-collected photos (e.g. Gambian dishes) as a separate dataset
# to merge in later.

path: ./dataset
train: images/train
val: images/val

names:
  0: apple
  1: banana
  2: orange
  3: mango
  4: watermelon
  5: grape
  6: pineapple
  7: strawberry
  8: lemon
  9: pear
  10: avocado
  11: bread
